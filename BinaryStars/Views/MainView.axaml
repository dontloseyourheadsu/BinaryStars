<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BinaryStars.ViewModels"
             xmlns:db="clr-namespace:BinaryStars.Services"
             xmlns:m="clr-namespace:BinaryStars.Models"
             xmlns:h="clr-namespace:BinaryStars.Helpers"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="700"
             x:Class="BinaryStars.Views.MainView"
             x:DataType="vm:MainViewModel"
             Background="#F0F2F5">

  <UserControl.Resources>
    <h:BoolToVisibilityConverter x:Key="BoolToVis" />
    <h:MessageAlignmentConverter x:Key="MsgAlign" />
    <h:MessageBackgroundConverter x:Key="MsgBg" />
    <h:TimestampConverter x:Key="TimeConv" />
    <h:NotNullToVisibilityConverter x:Key="NotNullToVis" />
    <h:FileSizeConverter x:Key="FileSizeConv" />
    <h:ByteArrayToImageSourceConverter x:Key="ByteToImg" />
  </UserControl.Resources>

  <Grid>
    <!-- VIEW 1: CHATS LIST -->
    <Grid RowDefinitions="Auto, *" IsVisible="{Binding IsChatsView}">
      <!-- Header -->
      <Border Background="#008069" Padding="16,20" BoxShadow="0 2 4 #33000000">
        <Grid ColumnDefinitions="*, Auto">
          <StackPanel>
            <TextBlock Text="BinaryStars" Foreground="White" FontSize="22" FontWeight="Bold" />
            <TextBlock Text="{Binding DisplayName, StringFormat='Logged in as {0}'}" Foreground="#B3FFFFFF" FontSize="12" Margin="0,2,0,0"/>
          </StackPanel>
          <Button Grid.Column="1" Command="{Binding GoToSettingsCommand}" Background="Transparent" Foreground="White" FontSize="20" Padding="5">
            ⚙
          </Button>
        </Grid>
      </Border>

      <!-- Main Body -->
      <Grid Grid.Row="1" RowDefinitions="Auto, *">
        <!-- Scan Header Button -->
        <Border Grid.Row="0" Background="White" Padding="16" BorderBrush="#EAEAEA" BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="*, Auto">
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Bluetooth Discovery" FontWeight="Bold" FontSize="16" Foreground="#111B21" />
              <TextBlock Text="Scan to find nearby devices" FontSize="12" Foreground="#667781" />
            </StackPanel>
            <Button Grid.Column="1" Command="{Binding ScanForDevicesCommand}" 
                    Background="#00a884" Foreground="White" CornerRadius="20" Padding="16,8" FontWeight="SemiBold">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <TextBlock Text="Scan" />
                <ProgressBar IsIndeterminate="True" Width="15" Height="15" IsVisible="{Binding IsScanning}" Foreground="White"/>
              </StackPanel>
            </Button>
          </Grid>
        </Border>

        <!-- Discovered Devices -->
        <Grid Grid.Row="1" RowDefinitions="Auto, *">
          <TextBlock Grid.Row="0" Text="NEARBY DEVICES" FontSize="12" FontWeight="Bold" Foreground="#008069" Margin="16,16,16,8"/>
          <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{Binding NearbyDevices}" Margin="16,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="m:BluetoothDeviceModel">
                  <Border Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,8" BoxShadow="0 1 2 #15000000">
                    <Grid ColumnDefinitions="*, Auto">
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="#111B21"/>
                        <TextBlock Text="{Binding Id}" FontSize="12" Foreground="#667781"/>
                      </StackPanel>
                      <Button Grid.Column="1" Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).SelectDeviceCommand}" CommandParameter="{Binding}"
                              Background="#008069" Foreground="White" CornerRadius="15" Padding="12,6" FontSize="12">
                        Connect
                      </Button>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Grid>
    </Grid>

    <!-- VIEW 2: CHAT ROOM -->
    <Grid RowDefinitions="Auto, *, Auto" IsVisible="{Binding IsChatRoomView}">
      <!-- Header -->
      <Border Background="#008069" Padding="12,16" BoxShadow="0 2 4 #33000000">
        <Grid ColumnDefinitions="Auto, *, Auto">
          <Button Command="{Binding GoBackCommand}" Background="Transparent" Foreground="White" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0">
            ←
          </Button>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="{Binding ActiveChat.DeviceName}" Foreground="White" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="{Binding StatusText}" Foreground="#D9FDD3" FontSize="12"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Message History List -->
      <ScrollViewer Grid.Row="1" Background="#E5DDD5">
        <ItemsControl ItemsSource="{Binding Messages}" Padding="12">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="db:MessageEntity">
              <Grid HorizontalAlignment="{Binding IsMe, Converter={StaticResource MsgAlign}}">
                <Border Background="{Binding IsMe, Converter={StaticResource MsgBg}}"
                        CornerRadius="8"
                        Padding="10,6"
                        Margin="0,0,0,8"
                        MaxWidth="300"
                        BoxShadow="0 1 1 #22000000">
                  <StackPanel Spacing="4">
                    <!-- Sender name if other -->
                    <TextBlock Text="{Binding Sender}" FontSize="11" FontWeight="Bold" Foreground="#128C7E" IsVisible="{Binding !IsMe}" />
                    
                    <!-- File Image Preview -->
                    <Border CornerRadius="4" ClipToBounds="True" IsVisible="{Binding AttachmentData, Converter={StaticResource NotNullToVis}}" MaxHeight="200" Margin="0,0,0,4">
                      <Image Source="{Binding AttachmentData, Converter={StaticResource ByteToImg}}" Stretch="Uniform" />
                    </Border>

                    <!-- Non-Image Attachment Box -->
                    <Border Background="#15000000" CornerRadius="4" Padding="8" Margin="0,0,0,4"
                            IsVisible="{Binding AttachmentName, Converter={StaticResource NotNullToVis}}">
                      <Grid ColumnDefinitions="Auto, *">
                        <TextBlock Text="📎" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <TextBlock Text="{Binding AttachmentName}" FontWeight="Bold" FontSize="12" TextWrapping="Wrap"/>
                          <TextBlock Text="{Binding AttachmentSize, Converter={StaticResource FileSizeConv}}" FontSize="10" Foreground="#555555"/>
                        </StackPanel>
                      </Grid>
                    </Border>

                    <!-- Message text -->
                    <TextBlock Text="{Binding Text}" Foreground="#111B21" TextWrapping="Wrap" FontSize="14"/>

                    <!-- Time -->
                    <TextBlock Text="{Binding Timestamp, Converter={StaticResource TimeConv}}" FontSize="9" Foreground="#667781" HorizontalAlignment="Right"/>
                  </StackPanel>
                </Border>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!-- Bottom Chat Bar -->
      <Border Grid.Row="2" Background="#F0F2F5" Padding="8" BorderBrush="#EAEAEA" BorderThickness="0,1,0,0">
        <Grid ColumnDefinitions="Auto, *, Auto">
          <!-- Attachment Button -->
          <Button Click="OnAddAttachmentClick" Background="Transparent" Foreground="#54656F" FontSize="22" Width="40" Height="40" Margin="0,0,4,0">
            📎
          </Button>

          <!-- Input field -->
          <TextBox Grid.Column="1" Text="{Binding MessageText}" Watermark="Type a message" 
                   CornerRadius="20" Background="White" BorderThickness="0" Padding="12,8" VerticalAlignment="Center"/>

          <!-- Send Button -->
          <Button Grid.Column="2" Command="{Binding SendMessageCommand}" 
                  Background="#00a884" Foreground="White" CornerRadius="20" Width="40" Height="40" Margin="4,0,0,0">
            ➔
          </Button>
        </Grid>
      </Border>
    </Grid>

    <!-- VIEW 3: SETTINGS -->
    <Grid RowDefinitions="Auto, *" IsVisible="{Binding IsSettingsView}">
      <!-- Header -->
      <Border Background="#008069" Padding="16,20" BoxShadow="0 2 4 #33000000">
        <TextBlock Text="Settings" Foreground="White" FontSize="20" FontWeight="Bold" />
      </Border>

      <!-- Settings Panel -->
      <StackPanel Grid.Row="1" Margin="20" Spacing="20">
        <StackPanel Spacing="5">
          <TextBlock Text="Display Name / Nickname" FontWeight="SemiBold" Foreground="#008069"/>
          <TextBox Text="{Binding DisplayName}" Watermark="Enter nickname" Background="White" Padding="10"/>
        </StackPanel>

        <StackPanel Spacing="5">
          <TextBlock Text="Device ID (v7 GUID)" FontWeight="SemiBold" Foreground="#667781"/>
          <TextBox Text="{Binding MyDeviceId, Mode=OneWay}" IsReadOnly="True" Background="#EAEAEA" Padding="10"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="15" HorizontalAlignment="Right" Margin="0,20,0,0">
          <Button Command="{Binding GoBackCommand}" Content="Cancel" Background="Transparent" Foreground="#667781" Padding="20,10"/>
          <Button Command="{Binding SaveSettingsCommand}" Content="Save" Background="#008069" Foreground="White" CornerRadius="4" Padding="25,10"/>
        </StackPanel>
      </StackPanel>
    </Grid>

    <!-- Connection Request Dialog Overlay -->
    <Border Background="#99000000" IsVisible="{Binding ShowConnectionRequestPrompt}" ZIndex="10">
      <Border Background="White" CornerRadius="12" Padding="24" Margin="30" VerticalAlignment="Center" BoxShadow="0 4 8 #66000000">
        <StackPanel Spacing="15">
          <TextBlock Text="Chat Invitation" FontSize="18" FontWeight="Bold" Foreground="#008069" HorizontalAlignment="Center"/>
          <TextBlock Text="{Binding PendingRequestSenderName, StringFormat='{}{0} wants to start a chat.'}" 
                     TextWrapping="Wrap" FontSize="14" HorizontalAlignment="Center" Margin="0,10"/>
          <TextBlock Text="{Binding PendingRequestAddress, StringFormat='Address: {0}'}" FontSize="12" Foreground="#667781" HorizontalAlignment="Center"/>
          
          <Grid ColumnDefinitions="*, *" Margin="0,15,0,0">
            <Button Command="{Binding RejectConnectionRequestCommand}" Content="Decline" Background="Transparent" Foreground="#D32F2F" Padding="20,10" HorizontalAlignment="Center"/>
            <Button Grid.Column="1" Command="{Binding AcceptConnectionRequestCommand}" Content="Accept" Background="#008069" Foreground="White" Padding="20,10" CornerRadius="4" HorizontalAlignment="Center"/>
          </Grid>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</UserControl>
